	)
	(text "Bootloader (HIGH) =  boot from system memory.\nElse (LOW) = boot from flash memory"
		(exclude_from_sim no)
		(at 36.322 28.702 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "2274a767-5cde-40c7-97d6-1fa67abc9c7c")
	)
	(text "PRÉSENTEMENT I2C_2 (et non I2C_1) =>\nJ'avais la flemme de le changer partout laule"
		(exclude_from_sim no)
		(at 54.864 139.954 0)
		(effects
