	(text "OSC_IN/OSC_OUT (pour le HSE = High-Speed external crystal, soit le crystal principal)\nOSC32_IN/OSC32_OUT (pour le LSE = Low-Speed external crystal, soit le crystal secondaire)\n"
		(exclude_from_sim no)
		(at 41.148 17.018 0)
		(effects
			(font
				(size 0.762 0.762)
			)
		)
		(uuid "a5f70697-52ea-4bd0-9124-421de7773997")
	)
	(text "VDD/VDDA sont à 3.3V\nVSS/VSSA sont à 0.0V (GND)\nMettre du découplage entre VDD et VDDA pour réduire \nle bruit qui vient des circuit numérique (fait dans la schematic \"alim + buck converter\")\n\n\n"
		(exclude_from_sim no)
		(at 111.506 79.248 0)
		(effects
