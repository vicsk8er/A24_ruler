	(text "RS = Register Select\nelle indique si on envoie une commande (0) ou une donnée (1)\nRESET = quand elle est a 0, on reset le lcd driver\nLEDK = anode de l'écran, elle fourni l'éclairage (doit être a 1)\nLEDA = cathode de l'écran, doit être au GND\nC'est ce que chat me dit pcq j'ai méga la fleme de vérifier live\nsinon la schématic est basé sur celle d'un breakout board so i guess we good\n"
		(exclude_from_sim no)
		(at 132.334 22.352 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "c9d64c0f-9693-48f6-b3b5-00b9c77595e6")
	)
